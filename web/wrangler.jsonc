{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minipaw",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
  },
  // Branch builds deploy with `wrangler preview`, which needs this block.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}

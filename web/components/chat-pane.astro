---
// A live minipaw chat in the page: the browser dials a terminal's ticket over
// WebTransport through the relay (lib/chat.ts, imported on connect, with its
// 3.6 MB of wasm). Without a `ticket` it asks for one to paste. With one, such
// as the paw bot's on the landing page, the chat box is there from the start:
// focusing it loads minip2p and connects, and anything sent before the
// connection is up goes out once it is. One pane per page.
interface Props {
  /** A fixed ticket to chat with; omit to have the visitor paste one. */
  ticket?: string;
  /** How the other side's lines are labelled. */
  peer?: string;
  /** The message box's placeholder. */
  placeholder?: string;
}

const { peer = "peer", placeholder, ticket } = Astro.props;
const loadNote = "Connecting loads minip2p, about 3.6 MB of WebAssembly, the first time.";
const autoNote =
  "Click into the box below to connect: that loads minip2p (about 3.6 MB of WebAssembly) and dials it through the relay.";
---

<div class="chat-pane" data-auto={ticket ? "" : undefined} data-chat data-peer={peer} data-phase="idle" data-ticket={ticket}>
  {
    !ticket && (
      <>
        <!-- data-astro-reload keeps the client router from treating a submit
             as a navigation, which would swap the page out from under the
             session; the script handles both forms. -->
        <form class="connect" data-astro-reload data-chat-connect>
          <input
            aria-describedby="chat-ticket-note"
            aria-label="Ticket from the terminal"
            autocomplete="off"
            class="field"
            data-chat-ticket
            placeholder="Paste the ticket minipaw printed"
            spellcheck="false"
            type="text"
          />
          <button class="btn" data-chat-go disabled type="submit">
            connect
          </button>
        </form>
        <p class="note" aria-live="polite" data-chat-ticket-note data-note={loadNote} id="chat-ticket-note">
          {loadNote}
        </p>
      </>
    )
  }

  <div class="session">
    <!-- The CLI's status line, live. -->
    <div class="status">
      <span class="fg">🐾 minipaw</span>
      <span><span data-chat-dot>○</span> <b data-chat-state>not connected</b></span>
      <span class="dim wide" data-chat-peer></span>
    </div>
    <ol aria-label="Chat" aria-live="polite" class="log" data-chat-log>
      {ticket && <li class="sys">{autoNote}</li>}
    </ol>
    <form class="compose" data-astro-reload data-chat-compose>
      <span aria-hidden="true" class="dim">you›</span>
      <input
        aria-label="Message"
        autocomplete="off"
        class="line"
        data-chat-message
        disabled={!ticket}
        enterkeyhint="send"
        maxlength="500"
        placeholder={placeholder}
        type="text"
      />
      <button class="btn" data-chat-send disabled={!ticket} type="submit">send</button>
      {!ticket && <button class="btn ghost" data-chat-leave type="button">leave</button>}
    </form>
  </div>
</div>

<style>
  .chat-pane {
    --paw-ok: oklch(83% 0.09 165);
    --rule: var(--blume-border);
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
  }
  :global(:root:not([data-theme="dark"])) .chat-pane {
    --paw-ok: oklch(52% 0.11 165);
  }
  .dim {
    color: var(--blume-muted-foreground);
  }
  .fg {
    color: var(--blume-foreground);
  }
  .note {
    margin: 0;
    font-size: 12px;
    color: var(--blume-muted-foreground);
  }

  .connect,
  .compose {
    display: flex;
    gap: 0.5rem;
  }
  .field {
    min-width: 0;
    flex: 1;
    border: 1px dashed var(--blume-muted-foreground);
    background: transparent;
    padding: 0.5rem 0.75rem;
    font-size: 13px;
    color: var(--blume-foreground);
  }
  .btn {
    flex-shrink: 0;
    background: var(--blume-foreground);
    padding: 0.375rem 0.875rem;
    font-size: 12px;
    color: var(--blume-background);
  }
  .btn.ghost {
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--blume-muted-foreground);
  }
  .btn.ghost:hover {
    color: var(--blume-foreground);
  }
  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }
  .field:focus-visible,
  .line:focus-visible,
  .btn:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
  }

  /* The session: a terminal pane, status line over the transcript over a
     prompt. Hidden until the first connect; the connect row hides while a
     session runs, and comes back to start another. */
  .session {
    display: none;
    border: 1px solid var(--rule);
    background: var(--blume-code-background);
  }
  [data-phase="active"] .session,
  [data-phase="ended"] .session {
    display: block;
  }
  [data-phase="active"] .connect,
  [data-phase="active"] .note {
    display: none;
  }
  [data-phase="ended"] .compose {
    display: none;
  }
  /* A fixed-ticket pane is a chat box from the start, and stays one: typing
     after a chat ends starts the next. */
  [data-auto] .session {
    display: block;
  }
  [data-auto][data-phase="ended"] .compose {
    display: flex;
  }
  .line::placeholder {
    color: var(--blume-muted-foreground);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid var(--rule);
    padding: 0.5rem 1rem;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
  }
  .status b {
    font-weight: 500;
  }
  .status [data-state="up"] {
    color: var(--paw-ok);
  }
  .status [data-state="down"] {
    color: var(--blume-accent);
  }
  .log {
    height: 18rem;
    margin: 0;
    overflow-y: auto;
    padding: 0.875rem 1rem;
    list-style: none;
  }
  .log :global(li) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.who) {
    margin-right: 0.5ch;
    color: var(--blume-muted-foreground);
    user-select: none;
  }
  .log :global(.you .who) {
    color: var(--blume-accent);
  }
  .log :global(.sys) {
    color: var(--blume-muted-foreground);
  }
  .log :global(.sys.ok) {
    color: var(--paw-ok);
  }
  .log :global(.sys.bad) {
    color: var(--blume-accent);
  }
  .log :global(.tick) {
    margin-left: 1ch;
    color: var(--blume-muted-foreground);
  }
  .log :global(.delivered .tick) {
    color: var(--paw-ok);
  }
  .compose {
    align-items: center;
    border-top: 1px solid var(--rule);
    padding: 0.5rem 0.5rem 0.5rem 1rem;
  }
  .line {
    min-width: 0;
    flex: 1;
    border: 0;
    background: transparent;
    padding: 0.25rem 0;
    color: var(--blume-foreground);
  }
  @media (max-width: 860px) {
    .status .wide {
      display: none;
    }
  }
</style>

<script>
  // Listeners are delegated from document: Blume's client router swaps the
  // page's DOM on navigation but runs this module once.
  import type { Chat, ChatState } from "../lib/chat";
  import { findTicket, parseTicket } from "../lib/ticket";
  import type { Ticket } from "../lib/ticket";

  let chat: Chat | undefined;
  // Bumped whenever the page lets go of its chat, so a connect still loading
  // lib/chat.ts when the visitor navigates away never starts.
  let generation = 0;
  // Leave was pressed: a resume after it must not reopen the message box.
  let leaving = false;
  // Lines sent in a fixed-ticket pane while lib/chat.ts is still loading,
  // with their rows: they go out once the session exists.
  let pending: { text: string; item: HTMLElement }[] = [];
  // The other side's current line, which its next text continues.
  let peerLine: HTMLElement | undefined;

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const pane = () => $<HTMLElement>("[data-chat]");
  // A fixed-ticket pane: the message box works before, during and after a
  // session, and using it is what connects.
  const isAuto = () => pane()?.dataset.auto !== undefined;

  const setPhase = (phase: string) => {
    const root = pane();
    if (root) {root.dataset.phase = phase;}
  };

  const short = (peerId: string) => `${peerId.slice(0, 8)}…${peerId.slice(-4)}`;

  const scrollDown = () => {
    const log = $("[data-chat-log]");
    log?.scrollTo({ top: log.scrollHeight });
  };

  // The transcript keeps its last MAX_ROWS rows, and wraps the other side's
  // lines at MAX_LINE characters, so a terminal piping output at the page
  // can't grow it without bound.
  const MAX_ROWS = 500;
  const MAX_LINE = 2000;

  const trim = () => {
    const log = $("[data-chat-log]");
    const extra = (log?.children.length ?? 0) - MAX_ROWS;
    for (const row of [...(log?.children ?? [])].slice(0, Math.max(extra, 0))) {
      row.remove();
    }
  };

  const append = (cls: string, who?: string) => {
    const item = document.createElement("li");
    item.className = cls;
    if (who) {
      const label = document.createElement("span");
      label.className = "who";
      label.textContent = who;
      item.append(label);
    }
    const body = document.createElement("span");
    item.append(body);
    $("[data-chat-log]")?.append(item);
    trim();
    scrollDown();
    return body;
  };

  const say = (text: string, tone = "") => {
    peerLine = undefined;
    append(`sys ${tone}`).textContent = text;
  };

  const status = (text: string, state: "up" | "down" | "idle") => {
    const label = $<HTMLElement>("[data-chat-state]");
    const dot = $<HTMLElement>("[data-chat-dot]");
    if (label) {
      label.textContent = text;
      label.dataset.state = state;
    }
    if (dot) {
      dot.textContent = state === "up" ? "●" : "○";
      dot.dataset.state = state;
    }
  };

  const setComposing = (on: boolean) => {
    if (isAuto()) {return;}
    for (const el of document.querySelectorAll<HTMLInputElement | HTMLButtonElement>(
      "[data-chat-message], [data-chat-send]"
    )) {
      el.disabled = !on;
    }
    if (on) {$<HTMLInputElement>("[data-chat-message]")?.focus({ preventScroll: true });}
  };

  const onState = (state: ChatState) => {
    switch (state.kind) {
      case "loading": {
        status("loading minip2p", "idle");
        say("loading minip2p…");
        break;
      }
      case "connecting": {
        status("connecting", "idle");
        say("connecting through the relay…");
        break;
      }
      case "up": {
        status(state.resumed ? "connected (resumed)" : "connected", "up");
        say(state.resumed ? "resumed" : "connected via relay", "ok");
        setComposing(!leaving);
        break;
      }
      case "reconnecting": {
        status("reconnecting", "down");
        say(`link lost (${state.reason}); reconnecting…`, "bad");
        setComposing(false);
        break;
      }
      case "ended": {
        status(state.ok ? "ended" : "failed", state.ok ? "idle" : "down");
        say(state.reason, state.ok ? "" : "bad");
        setComposing(false);
        // Offsets belong to one session: rows it never confirmed can't be
        // confirmed by the next one, whose offsets start over.
        for (const item of document.querySelectorAll<HTMLElement>(".log .you:not(.delivered)")) {
          delete item.dataset.end;
          const tick = item.querySelector<HTMLElement>(".tick");
          if (tick) {
            tick.textContent = "–";
            tick.title = "not confirmed before the chat ended";
          }
        }
        chat = undefined;
        pending = [];
        setPhase("ended");
        if (isAuto()) {say("type to start a new chat");}
        const go = $<HTMLButtonElement>("[data-chat-go]");
        if (go) {go.disabled = false;}
        break;
      }
      default: {
        break;
      }
    }
  };

  const onText = (text: string) => {
    const who = `${pane()?.dataset.peer ?? "peer"}›`;
    for (const [i, line] of text.split("\n").entries()) {
      if (i > 0) {peerLine = undefined;}
      let rest = line;
      while (rest !== "") {
        const room = MAX_LINE - (peerLine?.textContent?.length ?? 0);
        if (room <= 0) {peerLine = undefined;}
        peerLine ??= append("peer", who);
        const take = Math.min(rest.length, room > 0 ? room : MAX_LINE);
        peerLine.textContent += rest.slice(0, take);
        rest = rest.slice(take);
      }
    }
    trim();
    scrollDown();
  };

  // Our lines carry the session offset just past them; once the other side
  // has written that far, the line is on its screen.
  const onAcked = (offset: number) => {
    for (const item of document.querySelectorAll<HTMLElement>(".log .you:not(.delivered)")) {
      // Not handed to the session yet (or refused): nothing to confirm.
      if (item.dataset.end === undefined) {continue;}
      if (Number(item.dataset.end) > offset) {break;}
      item.classList.add("delivered");
      const tick = item.querySelector(".tick");
      if (tick) {tick.textContent = "✓";}
    }
  };

  const checkTicket = (input: HTMLInputElement) => {
    const raw = input.value.trim();
    const found = findTicket(raw);
    const note = $<HTMLElement>("[data-chat-ticket-note]");
    const go = $<HTMLButtonElement>("[data-chat-go]");
    let problem = "";
    if (raw && !found) {
      problem = "That isn't a whole ticket. Paste the full line minipaw printed.";
    } else if (found?.ticket.ownRelay) {
      problem = "This ticket names its own relay. The browser can only reach a minipaw on the default relay.";
    }
    if (note) {note.textContent = problem || (note.dataset.note ?? "");}
    if (go) {go.disabled = chat !== undefined || !found || Boolean(problem);}
    return problem ? undefined : found?.ticket;
  };

  // Our line's row, with the "…" that becomes ✓ once it's printed.
  const ourLine = (text: string) => {
    peerLine = undefined;
    const body = append("you", "you›");
    body.textContent = text;
    const item = body.parentElement ?? body;
    const tick = document.createElement("span");
    tick.className = "tick";
    tick.textContent = "…";
    tick.title = "✓ once the other side has printed it";
    item.append(tick);
    return item;
  };

  // Records where the session put a line, or that it didn't take it.
  const queue = (item: HTMLElement, end: number | undefined) => {
    if (end === undefined) {
      const tick = item.querySelector(".tick");
      if (tick) {tick.textContent = "not sent";}
      return;
    }
    item.dataset.end = String(end);
  };

  const connect = async (ticket: Ticket) => {
    $<HTMLButtonElement>("[data-chat-go]")?.setAttribute("disabled", "");
    setPhase("active");
    // A fixed-ticket pane keeps its transcript across chats.
    if (!isAuto()) {$("[data-chat-log]")?.replaceChildren();}
    peerLine = undefined;
    $("[data-chat-peer]")?.replaceChildren(`· peer ${short(ticket.peerId)}`);
    generation += 1;
    leaving = false;
    const mine = generation;
    try {
      const { startChat } = await import("../lib/chat");
      if (mine !== generation) {return;}
      // A session the page has let go of may still report; drop it.
      const live =
        <T,>(handler: (value: T) => void) =>
        (value: T) => {
          if (mine === generation) {handler(value);}
        };
      chat = startChat(ticket, { acked: live(onAcked), state: live(onState), text: live(onText) });
      // The session buffers what it's given until its stream is up.
      for (const { text, item } of pending) {queue(item, chat.send(`${text}\n`));}
      pending = [];
    } catch (error) {
      if (mine === generation) {
        onState({ kind: "ended", ok: false, reason: `couldn't load the chat: ${String(error)}` });
      }
    }
  };

  // Starts a fixed-ticket pane's session, unless one is already starting.
  const autoConnect = () => {
    const fixed = pane()?.dataset.ticket;
    const ticket = fixed ? parseTicket(fixed) : undefined;
    if (ticket && !chat && pane()?.dataset.phase !== "active") {void connect(ticket);}
  };

  const send = () => {
    const input = $<HTMLInputElement>("[data-chat-message]");
    if (!input || input.value === "") {return;}
    const text = input.value;
    if (!chat) {
      // A fixed-ticket pane takes the line now and sends it once connected.
      if (!isAuto()) {return;}
      input.value = "";
      pending.push({ item: ourLine(text), text });
      autoConnect();
      return;
    }
    // A terminal reads lines, so each message is one.
    const end = chat.send(`${text}\n`);
    if (end === undefined) {
      say("not sent: the other side isn't keeping up. Try again in a moment.", "bad");
      return;
    }
    input.value = "";
    queue(ourLine(text), end);
  };

  // Clicking into a fixed-ticket pane's box connects, so the bot is likely
  // there by the time the first line is typed.
  document.addEventListener("focusin", (event) => {
    const { target } = event;
    if (target instanceof HTMLInputElement && target.matches("[data-chat-message]") && isAuto()) {autoConnect();}
  });

  document.addEventListener("input", (event) => {
    const { target } = event;
    if (target instanceof HTMLInputElement && target.matches("[data-chat-ticket]")) {checkTicket(target);}
  });

  document.addEventListener("submit", (event) => {
    const { target } = event;
    if (!(target instanceof HTMLFormElement)) {return;}
    if (target.matches("[data-chat-connect]")) {
      event.preventDefault();
      if (chat) {return;}
      const fixed = pane()?.dataset.ticket;
      const input = $<HTMLInputElement>("[data-chat-ticket]");
      const ticket = fixed ? parseTicket(fixed) : input && checkTicket(input);
      if (ticket) {void connect(ticket);}
    } else if (target.matches("[data-chat-compose]")) {
      event.preventDefault();
      send();
    }
  });

  document.addEventListener("click", (event) => {
    const { target } = event;
    if (!(target instanceof Element) || !target.closest("[data-chat-leave]")) {return;}
    if (!chat) {
      // Still loading lib/chat.ts: drop the pending connect, so it never starts.
      if (pane()?.dataset.phase === "active") {
        generation += 1;
        onState({ kind: "ended", ok: true, reason: "connection cancelled" });
      }
      return;
    }
    say("leaving; waiting for the other side to finish…");
    leaving = true;
    setComposing(false);
    chat.leave();
  });

  // Leaving the page ends the session at once, so the other side hears now
  // rather than after its 60 s resume window.
  const abandon = () => {
    generation += 1;
    chat?.close("closed the chat page");
    // The session's own "ended" is dropped with its generation, so end the
    // pane here: a page restored from the back/forward cache can connect
    // again.
    if (pane()?.dataset.phase === "active") {
      onState({ kind: "ended", ok: true, reason: "closed when you left the page" });
    }
    chat = undefined;
  };
  document.addEventListener("astro:before-swap", abandon);
  window.addEventListener("pagehide", abandon);
</script>

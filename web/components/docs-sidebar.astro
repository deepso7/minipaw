---
// The docs sidebar, laid out like the landing page's: the wordmark and site
// links, search, Blume's page tree, then the theme toggle and license. On wide
// screens it stands in for Blume's header, which theme.css hides there; the
// mobile drawer gets just the page tree (components/docs-mobile-nav.astro),
// since the header still shows on narrow screens.
import NavTree from "blume/components/layout/NavTree.astro";
import data from "blume:data";

const { currentRoute } = Astro.props;

const site = [
  { href: "/", label: "Home" },
  { href: "/docs", label: "Docs" },
  { href: "/changelog", label: "Changelog" },
  { href: "https://github.com/deepso7/minipaw", label: "GitHub" },
];
const isCurrent = (href: string) =>
  href !== "/" && href.startsWith("/") && (currentRoute === href || currentRoute.startsWith(`${href}/`));
---

<div class="paw-sidebar" data-paw-sidebar>
  <a class="brand" href="/">
    <img alt="" class="sprite" height="22" src="/logo.svg" width="27" />
    minipaw
  </a>
  <nav aria-label="Site" class="site">
    {site.map((link) => (
      <a aria-current={isCurrent(link.href) ? "page" : undefined} href={link.href}>{link.label}</a>
    ))}
  </nav>
  {
    data.config.search.enabled && (
      <button class="search" data-paw-search type="button">
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>
    )
  }
  <div class="tree">
    <NavTree {...Astro.props} />
  </div>
  <div class="tools">
    <button class="tool" data-blume-theme-toggle type="button">
      <span class="when-dark">Light mode</span><span class="when-light">Dark mode</span>
    </button>
    <p>MIT or Apache-2.0<br />Built on <a href="https://github.com/deepso7/minip2p">minip2p</a></p>
  </div>
</div>

<style>
  .paw-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 100%;
    font-size: 13.5px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--blume-font-display-src);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--blume-foreground);
  }
  .sprite {
    image-rendering: pixelated;
  }
  .site {
    display: grid;
    gap: 0.125rem;
  }
  .site a {
    border-left: 1px solid transparent;
    padding: 0.125rem 0 0.125rem 0.75rem;
    color: var(--blume-muted-foreground);
  }
  .site a:hover,
  .site a[aria-current="page"] {
    color: var(--blume-foreground);
  }
  .site a[aria-current="page"] {
    border-left-color: var(--blume-foreground);
  }
  .search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--blume-border);
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    color: var(--blume-muted-foreground);
  }
  .search:hover {
    color: var(--blume-foreground);
  }
  kbd {
    border: 1px solid var(--blume-border);
    padding: 0 0.3rem;
    font: inherit;
    font-size: 11px;
  }
  .tree {
    border-top: 1px solid var(--blume-border);
    padding-top: 1rem;
  }
  /* Blume's page tree, restyled to match the site links above it: a thin
     track down the left, brightened beside the current page, instead of a
     filled pill. */
  .tree :global(.blume-nav-link) {
    display: block;
    border-left: 1px solid var(--blume-border);
    border-radius: 0;
    background: none;
    padding: 0.2rem 0 0.2rem 0.75rem;
    font-size: 13px;
    color: var(--blume-muted-foreground);
  }
  .tree :global(.blume-nav-link:hover) {
    background: none;
    color: var(--blume-foreground);
  }
  .tree :global(.blume-nav-link[aria-current="page"]) {
    border-left-color: var(--blume-foreground);
    background: none;
    color: var(--blume-foreground);
  }
  .tree :global(.blume-nav-heading) {
    margin-bottom: 0.4rem;
    padding: 0;
    font-size: 12px;
    font-weight: 400;
    color: var(--blume-muted-foreground);
  }
  .tree :global(li.mt-6) {
    margin-top: 1.25rem;
  }
  .tools {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    margin-top: auto;
    border-top: 1px solid var(--blume-border);
    padding-top: 1rem;
    font-size: 12px;
    color: var(--blume-muted-foreground);
  }
  .tools p {
    margin: 0;
    line-height: 1.6;
  }
  .tools a {
    text-decoration: underline;
    text-decoration-color: var(--blume-border);
    text-underline-offset: 4px;
  }
  .tool:hover {
    color: var(--blume-foreground);
  }
  .when-light {
    display: none;
  }
  :global(:root:not([data-theme="dark"])) .when-dark {
    display: none;
  }
  :global(:root:not([data-theme="dark"])) .when-light {
    display: inline;
  }
  .site a:focus-visible,
  .search:focus-visible,
  .tool:focus-visible,
  .brand:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // Opens Blume's search, whose own button sits in the header theme.css
  // hides on wide screens. Delegated from document, as the client router
  // swaps the sidebar on navigation, and guarded since the landing page
  // registers the same listener.
  const root = document.documentElement;
  if (root.dataset.pawSearchReady === undefined) {
    root.dataset.pawSearchReady = "";
    document.addEventListener("click", (event) => {
      const { target } = event;
      if (!(target instanceof Element) || !target.closest("[data-paw-search]")) {return;}
      document.querySelector<HTMLButtonElement>("[data-blume-search-open]")?.click();
    });
  }
</script>

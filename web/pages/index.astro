---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;

const install = "curl -fsSL https://paw.minip2p.com/install.sh | sh";
const ticket = "mpAQDEiiVb-s5zPPFvR0SjX0lVJgAkCAESINgMwzfDtX";

const recipes = [
  { title: "Chat", a: "minipaw", b: "minipaw <ticket>" },
  { title: "Send a file", a: "minipaw > report.pdf", b: "minipaw <ticket> < report.pdf" },
  { title: "Any pipe", a: "tar cz dir/ | minipaw", b: "minipaw <ticket> | tar xz" },
  { title: "SSH, no open ports", a: "minipaw serve", b: "minipaw ssh me@<ticket>" },
];

const features = [
  {
    title: "Gets through NATs",
    body: "Starts through a relay, then hole-punches a direct QUIC path when the networks allow, and moves the session over mid-transfer without losing a byte.",
  },
  {
    title: "End-to-end encrypted",
    body: "QUIC with TLS 1.3 when direct, a Noise session through the relay. The relay only ever sees ciphertext, and both sides are authenticated by peer ID.",
  },
  {
    title: "No accounts",
    body: "The ticket is the whole address: it carries the listener's public key and a random token. Share it like a password.",
  },
  {
    title: "Resumes after drops",
    body: "A relay cutting a circuit, a path upgrade, a network blip: both sides pick up from the last byte the other received, for up to 60 seconds.",
  },
  {
    title: "Backpressure",
    body: "The receiver acknowledges bytes only once they reach its stdout, so a slow reader slows the sender instead of filling memory.",
  },
  {
    title: "SSH without sshd",
    body: "minipaw serve --ssh answers with a built-in SSH server, scp and sftp included, letting in the keys from your authorized_keys.",
  },
];

const steps = [
  { title: "Listen", body: "One side reserves a slot on a relay and prints a ticket." },
  { title: "Dial", body: "The other side pastes the ticket and connects through the relay." },
  { title: "Go direct", body: "Hole punching upgrades the link to direct QUIC when it can." },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  page={{ title: "minipaw: pipe bytes, paw to paw", description: config.description }}
>
  <div class="landing">
    <section class="mx-auto grid max-w-5xl items-center gap-12 px-6 pt-16 pb-20 md:grid-cols-[1fr_auto] md:pt-24">
      <div>
        <p class="text-sm text-muted-foreground">peer-to-peer netcat</p>
        <h1 class="pixel mt-3 text-5xl leading-[1.05] md:text-6xl">pipe bytes,<br />paw to paw</h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground">
          Pipe stdin/stdout between two machines. minipaw gets through NATs, needs no accounts, and
          encrypts every byte end to end.
        </p>

        <div class="install mt-8 flex max-w-xl items-center gap-3 rounded-blume border border-border bg-code py-3 pr-2 pl-4 text-sm">
          <span class="text-muted-foreground select-none">$</span>
          <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap">{install}</code>
          <button
            class="copy shrink-0 rounded-blume px-3 py-1.5 text-xs text-muted-foreground hover:bg-muted hover:text-foreground"
            data-copy={install}
            type="button">copy</button
          >
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a class="rounded-blume bg-accent px-4 py-2 font-semibold text-accent-foreground" href="/docs">Read the docs</a>
          <a class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" href="https://github.com/deepso7/minipaw">GitHub →</a>
        </div>
      </div>

      <img
        alt=""
        class="sprite mx-auto hidden md:block"
        height="228"
        src="/paw-raised.svg"
        width="240"
      />
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-20">
      <div class="grid items-stretch gap-4 md:grid-cols-[1fr_auto_1fr]">
        <div class="term">
          <div class="term-bar"><span>machine A</span></div>
          <pre><span class="dim">$</span> minipaw
<span class="dim"># 🐾 listening; connect with:</span>
minipaw {ticket}…
hello</pre>
        </div>
        <div class="trail" aria-hidden="true">
          <img alt="" src="/icon.svg" width="16" height="16" />
          <img alt="" src="/icon.svg" width="16" height="16" />
          <img alt="" src="/icon.svg" width="16" height="16" />
        </div>
        <div class="term">
          <div class="term-bar"><span>machine B</span></div>
          <pre><span class="dim">$</span> echo hello | minipaw {ticket}…</pre>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-20">
      <h2 class="pixel text-3xl">one listens, one pastes</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        The listener prints a ticket. Whatever goes into one side comes out of the other.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          recipes.map((recipe) => (
            <div class="rounded-blume border border-border p-5">
              <h3 class="text-sm font-semibold">{recipe.title}</h3>
              <pre class="mt-3 overflow-x-auto rounded-blume bg-code p-3 text-[13px] leading-relaxed"><span class="dim">A$</span> {recipe.a}{"\n"}<span class="dim">B$</span> {recipe.b}</pre>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-20">
      <h2 class="pixel text-3xl">small, sturdy pipe</h2>
      <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div>
              <h3 class="flex items-center gap-2 text-sm font-semibold">
                <img alt="" class="sprite" height="13" src="/logo.svg" width="16" />
                {feature.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{feature.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-24">
      <h2 class="pixel text-3xl">how it works</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="rounded-blume border border-border p-5">
              <span class="text-xs text-accent">0{i + 1}</span>
              <h3 class="mt-1 text-sm font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-sm text-muted-foreground">
        Built on <a class="text-accent underline underline-offset-4" href="https://github.com/deepso7/minip2p">minip2p</a>,
        a small libp2p implementation in Rust. <a class="text-accent underline underline-offset-4" href="/docs">Read more in the docs</a>.
      </p>
    </section>
  </div>

  <footer class="landing border-t border-border" slot="footer">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-xs text-muted-foreground">
      <span class="flex items-center gap-2">
        <img alt="" class="sprite" height="13" src="/logo.svg" width="16" />
        minipaw · MIT or Apache-2.0
      </span>
      <span class="flex gap-5">
        <a class="hover:text-foreground" href="/docs">Docs</a>
        <a class="hover:text-foreground" href="/changelog">Changelog</a>
        <a class="hover:text-foreground" href="https://github.com/deepso7/minipaw">GitHub</a>
      </span>
    </div>
  </footer>
</PageLayout>

<style>
  .landing .pixel {
    font-family: "Pixelify Sans", var(--blume-font-mono);
    font-weight: 600;
    letter-spacing: 0;
  }
  .sprite,
  .trail img {
    image-rendering: pixelated;
  }
  .dim {
    color: var(--blume-muted-foreground);
  }
  .term {
    overflow: hidden;
    border: 1px solid var(--blume-border);
    border-radius: var(--blume-radius);
    background: var(--blume-code-background);
  }
  .term-bar {
    border-bottom: 1px solid var(--blume-border);
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    color: var(--blume-muted-foreground);
  }
  .term pre {
    margin: 0;
    overflow-x: auto;
    padding: 1rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 13px;
    line-height: 1.7;
  }
  .trail {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    opacity: 0.8;
  }
  .trail img:nth-child(2) {
    transform: translateY(-6px);
  }
  @media (max-width: 767px) {
    .trail {
      flex-direction: column;
      gap: 0.25rem;
    }
    .trail img:nth-child(2) {
      transform: translateX(6px);
    }
  }
</style>

<script>
  // Delegated from document: Blume's client router swaps the page's DOM on
  // navigation but runs this module once, so a listener on the button itself
  // would be lost after leaving the page and coming back.
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("button.copy");
    if (!button) return;
    await navigator.clipboard.writeText(button.dataset.copy ?? "");
    button.textContent = "copied";
    setTimeout(() => (button.textContent = "copy"), 1500);
  });
</script>
